# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit real values.

# Server Configuration
PORT=5000
# Optional MongoDB URI (if omitted, server uses local JSON file storage in server/data/)
MONGO_URI=

# Optional custom API URL for client (default is relative /api)
# VITE_API_URL=/api

# Google Sheets booking log (optional). See
# docs/google-sheets/BookingSheetSync.gs for the one-time setup — deploy
# that Apps Script as a Web App, then paste its /exec URL and the shared
# secret you chose in it here. Leave both blank to skip Sheets logging
# entirely; the booking form still works fine via Web3Forms without them.
VITE_SHEETS_WEBHOOK_URL=
VITE_SHEETS_SECRET=
